# The capacity planner (cmd/capacity-planner), for an operator with no
# checkout. Its API serves recordings from a directory mounted at /recordings:
#
#   docker run --rm --user "$(id -u):$(id -g)" -p 127.0.0.1:8080:8080 \
#     -v "$PWD/recordings:/recordings:ro" \
#     ghcr.io/llm-d-incubation/llm-d-scaling-manager/capacity-planner:<release>
#
# --user: recordings are written 0600, readable by their owner only. Never
# publish the port beyond 127.0.0.1, and never run this command with
# --network host. Then open http://localhost:8080. Any other command runs in place of serve:
# `... capacity-planner:<release> replicas-to-slo --recording /recordings/<file> ...`.
# Built and pushed by .github/workflows/ci-release.yaml beside the controller
# image, under the same tag, and checked by hack/check-capacity-planner-image.sh.
# docs/guides/capacity-planner/README.md.

# The controller's builder (Dockerfile), run on the build platform: the
# binary is pure Go, so each target platform is a cross-compile, not QEMU.
FROM --platform=$BUILDPLATFORM quay.io/projectquay/golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY cmd/capacity-planner/ cmd/capacity-planner/
COPY internal/ internal/

# The ldflags of `make capacity-planner` (LEARNREC_LDFLAGS: the commit a
# generated recording carries) and the release, printed by
# `capacity-planner version`.
ARG GIT_COMMIT=unknown
ARG VERSION=unreleased
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -trimpath -buildvcs=false \
    -ldflags "-X github.com/llm-d-incubation/llm-d-scaling-manager/internal/signals/learnrec.BuildCommit=${GIT_COMMIT} -X main.version=${VERSION}" \
    -o capacity-planner ./cmd/capacity-planner && \
    mkdir -p /workspace/recordings

FROM gcr.io/distroless/static:nonroot@sha256:f7f8f729987ad0fdf6b05eeeae94b26e6a0f613bdf46feea7fc40f7bd72953e6

ARG IMAGE_SOURCE=https://github.com/llm-d-incubation/llm-d-scaling-manager
LABEL org.opencontainers.image.source="${IMAGE_SOURCE}"
LABEL org.opencontainers.image.description="llm-d-scaling-manager capacity planner - price a fleet from a learner recording or a Prometheus window"
LABEL org.opencontainers.image.licenses="Apache-2.0"

COPY --from=builder /workspace/capacity-planner /capacity-planner
# Empty, so serve starts with nothing mounted; mount the recordings over it.
COPY --from=builder /workspace/recordings /recordings
USER 65532:65532
EXPOSE 8080

ENTRYPOINT ["/capacity-planner"]
# Every interface of the container, with no authentication: reachable only
# where the port is published, which the docs publish to the host's loopback
# alone (-p 127.0.0.1:8080:8080). With --network host, override this command
# with --listen 127.0.0.1:8080 and no --listen-all-in-container.
CMD ["serve", "--listen", "0.0.0.0:8080", "--listen-all-in-container", "--recordings", "/recordings"]
